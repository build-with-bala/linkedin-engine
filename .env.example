# All keys are OPTIONAL — the core library never reads env.
# These are consumed by packages/server and packages/cli only.

# Provider credentials (supply whichever you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ordered fallback chain for the server's default, comma-separated
PROVIDER_CHAIN=anthropic,openai

# Model overrides (optional)
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash

# Brand pack
BRAND_NAME=Your Brand
BRAND_DIR=./brand
BRAND_FILES=voice.md,guardrails.md,pillars.md
BRAND_FULL_STORY=full-story.md

# Optional headless-browser scrape service exposing POST /scrape
SCRAPER_URL=

# Server
PORT=4400
API_TOKEN=

{
  "name": "@linkedin-engine/core",
  "version": "0.1.0",
  "description": "Provider-agnostic LinkedIn content engine: generation, parsing, scraping, comment reply drafting.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
